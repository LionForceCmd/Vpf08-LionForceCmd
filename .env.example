# ---------------------------------------------------------------------------
# Скопируй этот файл в .env и заполни значения:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# Файл .env не коммитится в репозиторий (см. .gitignore).
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# --- Режим работы мозга ---------------------------------------------------
# auto   (по умолчанию) — использовать настоящую LLM, нужен ключ ниже
# offline — вообще без ключей: бот разбирает типовые фразы по правилам
#          и вызывает те же MCP-инструменты. Качество ответов ниже,
#          зато запускается где угодно и без внешних сервисов.
LLM_MODE=auto

# --- LLM (OpenAI или любой OpenAI-совместимый провайдер) -------------------
# При LLM_MODE=offline эту строку можно оставить пустой.
OPENAI_API_KEY=

# Модель из урока — GPT-4o-mini. Подойдёт и другая с поддержкой function calling:
# gpt-4o-mini, gpt-4o, gpt-4.1-mini, o4-mini, deepseek-chat, qwen-plus и т.п.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=60

# Если используешь не OpenAI, укажи свой совместимый endpoint:
# DeepSeek:  https://api.deepseek.com/v1        (нужен свой ключ)
# OpenRouter: https://openrouter.ai/api/v1      (нужен свой ключ)
# Ollama:     http://localhost:11434/v1         (ключ НЕ нужен, модель локальная)
#OPENAI_BASE_URL=https://api.deepseek.com/v1
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=http://localhost:11434/v1

# --- MCP-сервер -------------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TIMEOUT=20

# Необязательный токен. Если задать здесь — нужно задать его же в .env сервера
# (MCP_API_TOKEN), иначе сервер начнёт требовать Authorization: Bearer <token>.
#MCP_API_TOKEN=

# --- MCP-сервер: собственные настройки (нужны только mcp_server/settings.py) --
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_LOG_LEVEL=info
#MOVIE_DB_PATH=mcp_server/movies.db
#MOVIE_DB_SEED=true

# --- Поведение агента -------------------------------------------------------
# Сколько раз агент может вызвать инструменты подряд за один ответ
MAX_TOOL_ROUNDS=6
# Сколько последних сообщений диалога уходит в LLM
HISTORY_TURNS=12
